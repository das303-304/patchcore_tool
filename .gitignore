# ============================================================
# PatchCore Tool —— 忽略规则
# 原则：只入库源码与文档；模型、数据、运行时、构建产物一律不入库
# ============================================================

# ---------------- Python ----------------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# ---------------- 模型权重（体积大，每台机器各自建库生成） ----------------
*.onnx
*.pt
*.pth
*.pkl
*.pk
*.h5
*.pb
# 注意：不要写 *.engine —— Windows 下 git 忽略大小写，
# 它会把任何以 .Engine 结尾的目录一起吞掉。需要排除 TensorRT 文件时用 *.trt / *.plan。
*.trt
*.plan

# 建库产出目录
models/
models_onnx/
ok_data/
ng_data/
ok_images/
ng_images/
data/
datasets/
patchcore_roi.onnx*

# ---------------- 推理 / GPU 运行时（体积大，随环境安装） ----------------
cudart64_*.dll
cublas64_*.dll
cublasLt64_*.dll
cufft64_*.dll
cudnn*.dll
nvrtc*.dll
zlibwapi.dll
onnxruntime.dll
onnxruntime_providers_*

# ---------------- 图像 / 日志 / 临时产物 ----------------
*.jpg
*.jpeg
*.bmp
*.tif
*.tiff
*.gif
*.log
Logs/
*.tmp
*.temp
*.bak
*.bak-*
*.orig
*.rej
*~

# 保留文档中的图片
!docs/**/*.png
!docs/**/*.svg

# ---------------- 运行期产生的数据 ----------------
*_202[0-9]-*.json
prof_*.json
pc_prof_*.json
pc2_*.json
new_prof_*.json

# ---------------- 编辑器 / 系统 ----------------
Thumbs.db
desktop.ini
.DS_Store
*.swp
.idea/
.vscode/
