# ============================================================
# PatchCore Tool —— 忽略规则
# 原则：只入库源码与文档；模型、数据、运行时二进制、构建产物一律不入库
# ============================================================

# ---------------- Python ----------------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# ---------------- .NET ----------------
bin/
obj/
.vs/
*.user
*.suo
*.userprefs
*.cache
TestResults/
[Dd]ebug/
[Rr]elease/

# ---------------- 模型权重（体积大，各自现场生成） ----------------
*.onnx
*.pt
*.pth
*.pkl
*.pk
# 注意：不要写 *.engine —— Windows 下 git 忽略大小写，
# 它会连 csharp/Sen.Engine/ 这个目录一起吞掉（目录名以 .Engine 结尾）。
*.trt
*.plan
*.h5
*.pb
models/
models_onnx/
ok_data/
ng_data/
ok_images/
ng_images/
data/
datasets/
patchcore_roi.onnx*

# ---------------- 推理/GPU 运行时（约 2GB，随程序分发，不入库） ----------------
cudart64_*.dll
cublas64_*.dll
cublasLt64_*.dll
cufft64_*.dll
cudnn*.dll
nvrtc*.dll
zlibwapi.dll
onnxruntime.dll
onnxruntime.lib
onnxruntime_providers_*
ManagedCuda.dll
halcon.dll
halcondotnet.dll
MvCameraControl*.dll
*.dll
*.lib
*.pdb
*.exe

# 例外：确保源码不被误伤
!**/*.cs
!**/*.py

# ---------------- 图像 / 日志 / 临时产物 ----------------
*.jpg
*.jpeg
*.bmp
*.tif
*.tiff
*.gif
*.log
*.txt.log
Logs/
MvSdkLog/
*.tmp
*.temp
*.bak
*.bak-*
*.bak-w*
*.orig
*.rej
*~

# 保留文档中的图片
!docs/**/*.png
!docs/**/*.svg

# ---------------- 运行时产生的数据文件 ----------------
*_202[0-9]-*.json
prof_*.json
pc_prof_*.json
pc2_*.json
new_prof_*.json
*.vpr

# ---------------- 编辑器 / 系统 ----------------
Thumbs.db
desktop.ini
.DS_Store
*.swp
.idea/
