<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>YoloGpuBench</AssemblyName>
    <RootNamespace>YoloGpuBench</RootNamespace>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Vb>E:\ATK\转盘机视觉\XVision\bin\Debug\net8.0-windows</Vb>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="cn.YoloV3"><HintPath>$(Vb)\cn.YoloV3.dll</HintPath></Reference>
